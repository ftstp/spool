{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spool",
  "mainBinaryName": "Spool",
  "version": "0.1.1",
  "identifier": "app.pluginfixer.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir ../web dev",
    "devUrl": "http://127.0.0.1:1430",
    "beforeBuildCommand": "pnpm --dir ../web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [{ "title": "Spool", "width": 1440, "height": 900, "minWidth": 1024, "minHeight": 680, "backgroundColor": "#141312" }],
    "security": { "csp": "default-src 'self'; img-src 'self' media: http://media.localhost data:; media-src 'self' media: http://media.localhost; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Fatstep",
    "copyright": "Fatstep",
    "shortDescription": "Your Ableton Live catalogue, sorted and repaired",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": { "nsis": { "installMode": "currentUser", "languages": ["French", "English"], "displayLanguageSelector": false } }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQxNzZDRTRFM0NBRkM5OTEKUldTUnlhODhUczUyUVcvRVU3bG5SU3c0Zm5aakM0WGMxUmxYR2krY3JjM3hPNFhyRUsrcS94akQK",
      "endpoints": ["https://artists.fatstep.com/spool/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
